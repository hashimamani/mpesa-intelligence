// Auth + statement-upload schema (Stage 4 + Stage 5). Transaction/category/
// organization models (docs/04-database-erd.md) are added when the stages
// that need them start (Stage 6 extraction, Stage 12 organizations) — no
// tables ahead of the features that use them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Statements are owned by either a user or (once Stage 12 adds them) an
/// organization — ownerId is deliberately not an FK, since Postgres can't
/// cleanly express a polymorphic reference to two different tables. Every
/// query against Statement/StatementProcessingJob must filter on both
/// ownerType and ownerId — see docs/04-database-erd.md §Tenant isolation
/// enforcement.
enum OwnerType {
  user
  organization
}

enum StatementStatus {
  pending_upload
  uploaded
  processing
  processed
  failed
  needs_review
}

enum ProcessingStage {
  uploaded
  reading_transactions
  categorizing
  calculating_analytics
  generating_insights
  complete
}

/// Not in docs/04's original field list — added here because Stage 6's own
/// reconciliation logic (reconciliation.ts) already determines this
/// unambiguously from the running-balance delta, and TransactionType alone
/// can't reliably imply it (e.g. "other", "reversal"). Storing it now means
/// Stage 8's analytics never has to re-derive direction heuristically.
enum TransactionDirection {
  credit
  debit
}

enum TransactionType {
  send_money
  receive_money
  pay_bill
  buy_goods
  withdraw
  deposit
  airtime
  reversal
  fee
  other
}

/// classificationSource stays unset (null) until Stage 7's categorization
/// engine runs — Stage 6 only sets transactionType (deterministic, part of
/// normalization), never categoryId/subcategoryId.
enum ClassificationSource {
  rule
  merchant
  history
  ai
  user_correction
}

/// "global" = curated/seeded, applies to every owner. "learned" is reserved
/// for a future aggregate process (N independent owners' corrections
/// agreeing) that promotes a pattern into the shared table — docs/06 is
/// explicit that one owner's correction must never silently mutate global
/// merchant knowledge by itself. Nothing writes "learned" yet.
enum MerchantSource {
  global
  learned
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

/// One row per issued refresh token — this is the "session" in docs/05's
/// session/device management requirement. Only the hash is stored (never the
/// raw token, same principle as passwordHash); revoking a session sets
/// revokedAt instead of deleting the row, so a reused, already-rotated token
/// can be detected as a reuse/theft signal rather than just failing silently.
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique @map("token_hash")
  userAgent           String?   @map("user_agent")
  createdAt           DateTime  @default(now()) @map("created_at")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One uploaded document. periodStart/End and parserVersion are set once
/// Stage 6's real extraction runs. See docs/06-statement-processing-architecture.md
/// and docs/15-extraction-engine.md for what "processing" vs "processed" vs
/// "needs_review" actually mean at this stage (spoiler: no statement reaches
/// "processed" yet — that requires categorization/analytics too, Stage 7/8).
model Statement {
  id                    String          @id @default(uuid())
  ownerType             OwnerType       @map("owner_type")
  ownerId               String          @map("owner_id")
  s3Key                 String          @unique @map("s3_key")
  originalFilename      String          @map("original_filename")
  contentType           String          @map("content_type")
  sizeBytes             Int             @map("size_bytes")
  status                StatementStatus @default(pending_upload)
  /// S3's ETag for the uploaded object — a cheap content fingerprint, kept
  /// for reference/debugging. NOT enforced unique (it originally was, via
  /// `@@unique([ownerType, ownerId, documentFingerprint])`, which blocked
  /// re-uploading the exact same file — including a legitimate retry after
  /// a failed statement). Every upload is now treated as new; duplicate
  /// prevention lives at the transaction level instead
  /// (`Transaction.isDuplicateOf`, matched on referenceNumber+description+
  /// amount — see docs/15-extraction-engine.md), which is strictly more
  /// precise than blocking a whole re-upload ever was. Null until upload is
  /// confirmed.
  documentFingerprint   String?         @map("document_fingerprint")
  pageCount             Int?            @map("page_count")
  periodStart           DateTime?       @map("period_start") @db.Date
  periodEnd             DateTime?       @map("period_end") @db.Date
  parserVersion         String?         @map("parser_version")
  classificationVersion String?         @map("classification_version")
  analyticsVersion      String?         @map("analytics_version")
  insightVersion        String?         @map("insight_version")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  jobs            StatementProcessingJob[]
  rawTransactions RawTransaction[]
  transactions    Transaction[]

  @@index([ownerType, ownerId])
  @@map("statements")
}

model StatementProcessingJob {
  id          String          @id @default(uuid())
  statementId String          @map("statement_id")
  statement   Statement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  stage       ProcessingStage @default(uploaded)
  startedAt   DateTime?       @map("started_at")
  completedAt DateTime?       @map("completed_at")
  errorCode   String?         @map("error_code")
  retryCount  Int             @default(0) @map("retry_count")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([statementId])
  @@map("statement_processing_jobs")
}

/// Exactly what the parser found for one row of the document, before any
/// interpretation — immutable once written, kept separate from Transaction
/// per docs/04-database-erd.md §Design rule 3. A row that failed to parse
/// still gets a RawTransaction (parsed = false), so extraction failures are
/// inspectable rather than silently dropped.
model RawTransaction {
  id          String    @id @default(uuid())
  statementId String    @map("statement_id")
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  rowIndex    Int       @map("row_index")
  rawText     String    @map("raw_text")
  parsed      Boolean
  parseError  String?   @map("parse_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([statementId])
  @@map("raw_transactions")
}

/// Normalized, analytics-facing transaction. Stage 7 turned categoryId/
/// subcategoryId/merchantId into real FK relations (were plain nullable
/// columns through Stage 6, unset until the categorization engine existed).
/// Deliberately denormalizes ownerType/ownerId from Statement (rather than
/// requiring a join for every tenant-scoped query) — see docs/15's tenant
/// isolation note for why.
model Transaction {
  id                       String                @id @default(uuid())
  statementId              String                @map("statement_id")
  statement                Statement             @relation(fields: [statementId], references: [id], onDelete: Cascade)
  ownerType                OwnerType             @map("owner_type")
  ownerId                  String                @map("owner_id")
  /// Position among reconstructed PDF lines — the idempotency key within a
  /// statement. NOT referenceNumber: a real statement commonly emits several
  /// rows under the same receipt number for one real-world transaction (a
  /// payment plus its own "Charge" line, a Fuliza payment plus its
  /// "OverDraft of Credit Party" line) — found against a real statement, see
  /// docs/15-extraction-engine.md. referenceNumber stays a plain indexed
  /// field, used for cross-statement duplicate detection, not uniqueness.
  rowIndex                 Int                   @map("row_index")
  transactionDate          DateTime              @map("transaction_date")
  transactionType          TransactionType       @map("transaction_type")
  direction                TransactionDirection
  /// NUMERIC, never float — see docs/03-architecture.md §Money handling.
  amount                   Decimal               @db.Decimal(14, 2)
  fee                      Decimal               @default(0) @db.Decimal(14, 2)
  currency                 String                @default("KES")
  balanceAfter             Decimal?              @map("balance_after") @db.Decimal(14, 2)
  description              String
  rawDescription           String                @map("raw_description")
  merchantName             String?               @map("merchant_name")
  merchantId               String?               @map("merchant_id")
  merchant                 Merchant?             @relation(fields: [merchantId], references: [id])
  /// Always the TOP-LEVEL category (parentId null) — pairs with
  /// subcategoryId, which holds the specific child when the classifier (or a
  /// user correction) resolved one. See categorization/classifier.ts.
  categoryId               String?               @map("category_id")
  category                 Category?             @relation("TransactionCategory", fields: [categoryId], references: [id])
  subcategoryId            String?               @map("subcategory_id")
  subcategory              Category?             @relation("TransactionSubcategory", fields: [subcategoryId], references: [id])
  classificationConfidence Float?                @map("classification_confidence")
  classificationSource     ClassificationSource? @map("classification_source")
  referenceNumber          String                @map("reference_number")
  /// Set when this exact receipt number already exists for this owner from a
  /// different statement (e.g. overlapping re-upload) — docs/06's duplicate
  /// detection. The row is kept (visible, auditable) but flagged so Stage 8's
  /// analytics can exclude it from totals.
  isDuplicateOf            String?               @map("is_duplicate_of")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  categoryCorrections CategoryCorrection[]

  @@unique([statementId, rowIndex])
  @@index([ownerType, ownerId, transactionDate])
  @@index([ownerType, ownerId, referenceNumber])
  @@map("transactions")
}

/// Self-referential, hierarchical taxonomy (docs/04-database-erd.md) — a
/// top-level row has parentId null (e.g. "Spending"), a subcategory's
/// parentId points to its top-level parent (e.g. "Food & Dining" under
/// "Spending"). `slug` is the stable key code refers to (taxonomy.ts) —
/// database ids are generated and must never be hardcoded into rule logic.
/// Seeded idempotently at the start of every processing job (see
/// categorization/taxonomy-seeder.ts) rather than via a separate migration-
/// adjacent step someone has to remember to run.
model Category {
  id        String     @id @default(uuid())
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  slug      String     @unique
  name      String
  isActive  Boolean    @default(true) @map("is_active")
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at")

  merchants                 Merchant[]
  transactionsAsCategory    Transaction[]        @relation("TransactionCategory")
  transactionsAsSubcategory Transaction[]        @relation("TransactionSubcategory")
  corrections               CategoryCorrection[]

  @@map("categories")
}

/// Recognized counterparty (docs/06 categorization layer 2). `normalizedName`
/// is the uppercased/whitespace-collapsed key transactions are matched
/// against (categorization/merchant-normalization.ts) — `canonicalName`
/// stays the display form. Seeded with a small curated list (`source:
/// global`); `learned` is reserved for a future aggregate-agreement process,
/// never written by a single owner's correction (docs/06).
model Merchant {
  id                String         @id @default(uuid())
  canonicalName     String         @map("canonical_name")
  normalizedName    String         @unique @map("normalized_name")
  defaultCategoryId String?        @map("default_category_id")
  defaultCategory   Category?      @relation(fields: [defaultCategoryId], references: [id])
  source            MerchantSource @default(global)
  createdAt         DateTime       @default(now()) @map("created_at")

  transactions Transaction[]

  @@map("merchants")
}

/// A user's explicit override — always wins over any automatic
/// classification (docs/06 layer 5). Scoped to the owner, feeds back into
/// layer 3 (historical classification) for that owner's future
/// transactions sharing the same merchant/description — never mutates
/// Merchant.defaultCategoryId directly.
model CategoryCorrection {
  id                 String      @id @default(uuid())
  transactionId      String      @map("transaction_id")
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ownerType          OwnerType   @map("owner_type")
  ownerId            String      @map("owner_id")
  previousCategoryId String?     @map("previous_category_id")
  /// The specific category the user picked — may itself be a subcategory
  /// (leaf) row; the service layer normalizes this into the Transaction's
  /// (categoryId, subcategoryId) pair. See transactions/transactions.service.ts.
  newCategoryId      String      @map("new_category_id")
  newCategory        Category    @relation(fields: [newCategoryId], references: [id])
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([ownerType, ownerId, createdAt])
  @@map("category_corrections")
}

/// Precomputed period aggregate — a CACHE, always rebuildable from
/// Transaction (docs/04-database-erd.md), never the source of truth itself.
/// analytics/summary.ts recomputes and upserts this row from scratch every
/// time it's asked for a period (on statement processing, on a category
/// correction, and on every read) rather than trusting it as fresh without
/// checking — a stale cached number shown to a user about their own money
/// is exactly the trust failure docs/10's risk list warns about. One row
/// per (owner, calendar month) — periods are always full calendar months,
/// see docs/17-analytics-engine.md.
model SpendingSummary {
  id               String    @id @default(uuid())
  ownerType        OwnerType @map("owner_type")
  ownerId          String    @map("owner_id")
  periodStart      DateTime  @map("period_start") @db.Date
  periodEnd        DateTime  @map("period_end") @db.Date
  /// The full computed SpendingSummaryDTO content (docs/17) as JSON — a
  /// flexible cache payload, not a rigid schema, so adding a new computed
  /// figure later doesn't need a migration.
  totalsJson       Json      @map("totals_json")
  analyticsVersion String    @map("analytics_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([ownerType, ownerId, periodStart, periodEnd])
  @@map("spending_summaries")
}
