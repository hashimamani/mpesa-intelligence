# Copy to .env and fill in for local development.
# Never commit a real .env file. No real secrets belong in this repo, ever.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000

# Local Postgres, started via `npm run dev:services` (docker-compose).
DATABASE_URL=postgresql://mpesa:mpesa_local_password@localhost:5433/mpesa_intelligence

# Local Redis, started via docker-compose.
REDIS_URL=redis://localhost:6379

# Local S3-compatible storage (MinIO), started via docker-compose.
# In production this points at a real private S3 bucket + IAM role, never a static key.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mpesa-statements-dev
S3_ACCESS_KEY_ID=mpesa_local
S3_SECRET_ACCESS_KEY=mpesa_local_password

# Auth
JWT_SECRET=replace_me_with_a_random_local_only_value
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# AI provider (abstracted — see docs/07-ai-architecture.md). Leave unset locally;
# insight generation is skipped/mocked in tests only, never faked in a real code path.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=

# Billing provider — not yet selected (see docs/10-risks-and-decisions.md, D-4).
BILLING_PROVIDER=
BILLING_PROVIDER_API_KEY=
BILLING_WEBHOOK_SECRET=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Admin (apps/admin) ---
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000
